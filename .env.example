# LLM provider: ollama | openai | anthropic
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
SUPERVISOR_MODEL=qwen2.5:7b
SPECIALIST_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# Optional cloud providers (only needed if LLM_PROVIDER=openai|anthropic)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SUPERVISOR_MODEL=gpt-4o-mini
OPENAI_SPECIALIST_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_SUPERVISOR_MODEL=claude-3-5-haiku-latest
ANTHROPIC_SPECIALIST_MODEL=claude-3-5-haiku-latest

ORCHESTRATOR_STUB_LLM=0
ORCHESTRATOR_AUTO_APPROVE=0
HITL_FORCE_FINAL=1

# Infra (all free via Docker)
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@127.0.0.1:5432/orchestrator
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# OpenTelemetry → Jaeger (OTLP)
OTEL_SERVICE_NAME=agent-orchestration
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_ENABLED=1

# Optional LangSmith (free Developer tier ~5k traces/mo) — keep Jaeger as primary
LANGSMITH_TRACING=0
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-orchestration

# MCP — demo server auto-loads when enabled
MCP_ENABLED=1
# Optional override JSON list; empty = use mcp_servers/demo_server.py
MCP_SERVERS=

# Code sandbox: local | e2b
CODE_SANDBOX=local
E2B_API_KEY=

DATA_DIR=./data
WORKSPACE_DIR=./data/workspace
CHROMA_DIR=./data/chroma
